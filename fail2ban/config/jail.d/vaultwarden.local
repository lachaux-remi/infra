[vaultwarden]
enabled = true
chain = DOCKER-USER
port = http,https
filter = vaultwarden
mode = aggressive
logpath = /logs/vaultwarden/vaultwarden.log
maxretry = 5
bantime = 6h

[vaultwarden-admin]
enabled = true
chain = DOCKER-USER
port = http,https
filter = vaultwarden-admin
mode = aggressive
logpath = /logs/vaultwarden/vaultwarden.log
maxretry = 3
bantime = 1d
